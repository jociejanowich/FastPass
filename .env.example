# FastPass environment configuration
# The demo runs entirely on mock data and needs NONE of these values set.
# They document where real integrations would plug in later.

# --- Data source selection ---
# "mock" (default) | "dataverse"
VITE_FASTPASS_DATA_SOURCE=mock

# --- Dataverse (future) ---
# No client ID / tenant ID here: the app runs as a Power Platform "Code App"
# (via @microsoft/power-apps), which supplies an already-authenticated data
# client and user context at runtime. The one piece env vars can't provide is
# `dataSourcesInfo`, generated by `pac code add-data-source` — see
# src/data/powerAppsDataSources.ts and the README.

# --- Microsoft Graph profile adapter (future) ---
VITE_GRAPH_CLIENT_ID=
VITE_GRAPH_TENANT_ID=

# --- AI assistant service (future) ---
# "mock" (default) | "azure-openai" | "copilot-studio"
VITE_ASSISTANT_ENGINE=mock
VITE_AZURE_OPENAI_ENDPOINT=
VITE_AZURE_OPENAI_DEPLOYMENT=

# --- "About Me" development-profile analysis (future) ---
# "mock" (default, local deterministic analysis) | "power-automate"
VITE_PROFILE_ANALYSIS=mock
VITE_PROFILE_FLOW_URL=
